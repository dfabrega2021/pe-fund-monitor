# Postgres connection string (Supabase project: Settings -> Database -> Connection string).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase Storage, for original uploaded PDFs (audit trail / re-processing).
# Project Settings -> API. Use the service_role key (server-side only, never expose to the client).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared password gating access to the app. Leave blank to disable auth for local dev.
APP_PASSWORD=changeme

# --- AI extraction backend -------------------------------------------------
# Document classification + extraction run entirely on a local vision model
# served by Ollama - no third-party API call is made anywhere in this
# pipeline, which is what makes it safe to run against real, confidential GP
# reports under NDA. See architecture.md's "Data Handling & Confidentiality"
# section. Setup steps are in lib/ai/providers/ollama.ts.
#
# All optional - defaults shown below work with a stock Ollama install.
# Default model is "llava-phi3" (tested stable on an 8GB Mac). Only switch to
# a larger model (e.g. qwen2.5vl:7b, better accuracy) once you've confirmed
# your machine has real free RAM to spare - a 7B model crashed a machine
# during testing when RAM was tight.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_VISION_MODEL=llava-phi3
# OLLAMA_TIMEOUT_MS=300000
# Pages sent to the model per call - keep small on constrained hardware /
# small-context models (see providers/ollama.ts for the token-budget math).
# OLLAMA_PAGES_PER_CHUNK=2

# --- Hosted demo deployment (e.g. Vercel) only ------------------------------
# There's no Ollama reachable from a hosted server, so upload/extraction is
# disabled there rather than left as a broken form. Leave unset (defaults to
# available) for local dev where Ollama actually runs.
# NEXT_PUBLIC_EXTRACTION_AVAILABLE=false
